node_modules/
dist/
.wrangler/
# Wrangler local secrets. The glob matters: `--env <name>` reads
# `.dev.vars.<name>`, which a bare `.dev.vars` pattern does not cover — and
# these files hold the origin HMAC secret.
.dev.vars*

# Environment files. Nothing has leaked, but docs/paper-environment.md hands
# contributors a database password and an HMAC secret as shell variables, and
# the obvious next step is to park them in a .env — which would have committed
# clean before this line existed.
.env
.env.*
!.env.example
*.log
package-lock.json

# Never commit a publish token.
.npmrc

# mcp-publisher credentials.
#
# The 1.x CLI wrote these into the working directory of whatever package it was
# publishing — a live GitHub token and a registry token, untracked and NOT
# previously ignored, in a PUBLIC repo. One `git add -A` would have published a
# working credential. Newer versions store them under ~/.config/mcp-publisher/
# instead, but this stays so an older CLI (or a second checkout) cannot
# reintroduce it.
.mcpregistry_github_token
.mcpregistry_registry_token
